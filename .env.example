# Backend environment (production-ready template)
# Copy to `.env` locally and replace placeholder values.

NODE_ENV=production
PORT=3000

# Supabase Postgres (Session/Transaction pooler for IPv4 environments)
# Important:
# - Do NOT use <> in final values.
# - URL-encode password if it contains special chars (@, #, %, :, /, ?).
DATABASE_URL=postgresql://postgres:REPLACE_WITH_URLENCODED_PASSWORD@REPLACE_WITH_POOLER_HOST:6543/postgres?sslmode=require&pgbouncer=true
DIRECT_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URLENCODED_PASSWORD@REPLACE_WITH_POOLER_HOST:6543/postgres?sslmode=require&pgbouncer=true

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CORS_ORIGIN=https://REPLACE_WITH_FRONTEND_DOMAIN.vercel.app

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=.yourdomain.com

UTM_VALUE_CLP=65000

# Optional mail settings
SUPPORT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TIMEOUT_MS=15000
